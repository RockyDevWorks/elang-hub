# Copy this file to `.env` and edit before `docker compose up`.
#
# Docker Compose reads `.env` automatically for variable substitution
# in `docker-compose.yml`. The values below are the only ones the Hub
# needs for container deployment. HUB_ORIGIN is baked into the image;
# the other values configure runtime behavior and port publishing.

# Base URL of the ELANG SDK validation service.
#
# `/api/phonemes` and `/api/validate` proxy bytes to this URL and
# surface its `validate` response. Without this set, those endpoints
# return 503 with a descriptive error body — the page still loads.
#
# Examples:
#   SDK_SERVICE_URL=https://your-fly-app.fly.dev
#   SDK_SERVICE_URL=http://host.docker.internal:8080   # for local
#                                                       # SDK dev
SDK_SERVICE_URL=

# Host port to publish the Hub on. Defaults to 3000.
HUB_PORT=3000

# Public origin of this Hub, as the browser sees it (scheme, host, optional port).
# Compose passes this build argument to SvelteKit's paths.origin for absolute
# URL construction and CSRF checks. Set it for your public host and HUB_PORT,
# including https when TLS terminates at a reverse proxy. After changing it,
# rebuild with `docker compose up --build`; a runtime override has no effect.
HUB_ORIGIN=http://localhost:3000
