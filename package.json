{
	"name": "elang-hub",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "vitest",
		"coverage": "svelte-kit sync && vitest run --coverage"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^4.1.12",
		"autoprefixer": "^10.4.20",
		"axe-core": "^4.14.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^15.14.0",
		"happy-dom": "^21.0.4",
		"postcss": "^8.4.49",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.2.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.12",
		"wrangler": "^4.153.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	},
	"engines": {
		"node": ">=22.17"
	},
	"browserslist": [
		"chrome >= 111",
		"edge >= 111",
		"firefox >= 128",
		"safari >= 16.4",
		"ios_saf >= 16.4"
	]
}
